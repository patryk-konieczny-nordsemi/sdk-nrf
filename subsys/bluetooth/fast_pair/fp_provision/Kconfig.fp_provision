menuconfig FP_PROVISION_DATA
	bool "Fast Pair provisioning registration"
	depends on PROVISIONER
	help
	  Link Fast Pair KMU/ITS registration entries into the provisioner.
	  Does not enable the Fast Pair Bluetooth stack.

if FP_PROVISION_DATA

config FP_PROVISION_MODEL_ID
	hex "Fast Pair Model ID"
	default 0x0
	help
	  Fast Pair Model ID written to PSA Internal Trusted Storage. Obtained during
	  device model registration in the Google Nearby Console. A 24-bit value
	  (0x000000 - 0xFFFFFF).

config FP_PROVISION_ANTI_SPOOFING_KEY
	string "Fast Pair Anti-Spoofing Private Key (base64)"
	default ""
	help
	  Base64-encoded Anti-Spoofing Private Key imported into the CRACEN KMU.
	  Confidential. It is decoded at build time (see fp_provision_key_gen.py)
	  so no base64 decoding is performed on the device.

config FP_PROVISION_KMU_SLOT
	int "CRACEN KMU slot for the Anti-Spoofing private key"
	default 30
	help
	  KMU slot index (RAW usage scheme) that stores the 256-bit Anti-Spoofing
	  private key. A 256-bit key occupies two consecutive KMU slots, so keep
	  the following slot (this value + 1) free. Must match
	  CONFIG_BT_FAST_PAIR_KMU_SLOT of the application image.

config FP_PROVISION_ITS_ID
	int "PSA Internal Trusted Storage UID for the Model ID"
	default 2000
	help
	  PSA Internal Trusted Storage uid used to store the Fast Pair Model ID. Must
	  match CONFIG_BT_FAST_PAIR_ITS_ID of the application image.

endif # FP_PROVISION_DATA
