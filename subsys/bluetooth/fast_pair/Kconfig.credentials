menu "Fast Pair credentials (KMU / ITS)"

config BT_FAST_PAIR_ANTI_SPOOFING_PRIVATE_KEY_KMU_SLOT
	int "CRACEN KMU slot for the Anti-Spoofing private key"
	range 0 178
	default 30
	help
	  KMU slot index (RAW usage scheme) for the 256-bit Anti-Spoofing key.
	  Must match on provisioner and application images.

	  When building with sysbuild, this config cannot be set manually.
	  The value is overwritten by sysbuild Kconfig.

config BT_FAST_PAIR_MODEL_ID_ITS_ID
	hex "PSA Internal Trusted Storage UID for the Model ID"
	range 0x1 0xFFFEFFFF
	default 0x30000
	help
	  PSA ITS uid for the 24-bit Fast Pair Model ID.
	  Must match on provisioner and application images.

	  When building with sysbuild, this config cannot be set manually.
	  The value is overwritten by sysbuild Kconfig.

if BT_FAST_PAIR_RUNTIME_PROVISIONER

config BT_FAST_PAIR_MODEL_ID
	hex "Fast Pair Model ID"
	range 0x000000 0x1000000
	default 0x1000000
	help
	  24-bit Model ID (0x000000–0xFFFFFF). Embedded in the runtime
	  provisioner image and written to ITS at provisioning time.

	  When building with sysbuild, this config cannot be set manually.
	  The value is overwritten by sysbuild Kconfig.

config BT_FAST_PAIR_ANTI_SPOOFING_PRIVATE_KEY
	string "Anti-Spoofing Private Key (base64)"
	default ""
	help
	  Base64-encoded Anti-Spoofing private key for the runtime provisioner.
	  Confidential. Decoded at build time; not decoded on device.

	  When building with sysbuild, this config cannot be set manually.
	  The value is overwritten by sysbuild Kconfig.

endif # BT_FAST_PAIR_RUNTIME_PROVISIONER

endmenu
