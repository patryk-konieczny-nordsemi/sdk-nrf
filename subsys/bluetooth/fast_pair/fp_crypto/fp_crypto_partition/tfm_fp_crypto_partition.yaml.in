{
  "psa_framework_version": 1.1,
  "name": "TFM_SP_FPC",
  "type": "APPLICATION-ROT",
  "priority": "NORMAL",
  "model": "SFN",
  "entry_init": "tfm_fp_crypto_init",
  "stack_size": "0x1000",

  "services": [
    {
      "name": "TFM_FP_CRYPTO",
      "sid": "0x00001001",
      "non_secure_clients": true,
      "connection_based": false,
      "stateless_handle": "auto",
      "version": 1,
      "version_policy": "STRICT",
    }
  ],

  "dependencies": [
    "TFM_CRYPTO"
  ]
}
