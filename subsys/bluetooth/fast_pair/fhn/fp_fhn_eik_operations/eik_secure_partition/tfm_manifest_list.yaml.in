{
  "description": "TF-M EIK secure partition manifests",
  "type": "manifest_list",
  "version_major": 0,
  "version_minor": 1,
  "manifest_list": [
    {
      "description": "EIK Secure Operation Partition",
      "short_name": "TFM_EIK",
      "manifest": "${EIK_SECURE_PARTITION_YAML}",
      "output_path": "${EIK_SECURE_PARTITION_TFM_OUT}",
      "tfm_partition_ipc": false,
      "version_major": 0,
      "version_minor": 1,
      "linker_pattern": {
        "library_list": [
          "*tfm_*partition_eik.*"
          ],
      }
    }
  ]
}
