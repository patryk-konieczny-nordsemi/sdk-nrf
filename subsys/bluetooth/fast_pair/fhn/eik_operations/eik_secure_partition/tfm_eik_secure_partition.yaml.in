{
  "psa_framework_version": 1.1,
  "name": "TFM_SP_EIK",
  "type": "APPLICATION-ROT",
  "priority": "NORMAL",
  "model": "SFN",
  "entry_init": "tfm_eik_secure_init",
  "stack_size": "0x1000",

  "services": [
    {
      "name": "TFM_EIK_SECURE",
      "sid": "0x00001002",
      "non_secure_clients": true,
      "connection_based": false,
      "stateless_handle": "auto",
      "version": 1,
      "version_policy": "STRICT",
    }
  ],

  "dependencies": [
    "TFM_CRYPTO",
    "TFM_INTERNAL_TRUSTED_STORAGE_SERVICE"
  ]
}
