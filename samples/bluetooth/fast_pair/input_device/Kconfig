source "Kconfig.zephyr"

# Define the FP_PROVISION_* symbols (shared with the provisioner) so that, when
# the provisioner source is selected with APP_SOURCE=provisioner, sysbuild can
# inject the Fast Pair credentials into this image. rsource resolves relative to
# this file (source/osource would use $srctree).
rsource "../provisioner/Kconfig.fp_provision"

config SETTINGS
	default y

config ZMS
	default y if (SOC_FLASH_NRF_RRAM || SOC_FLASH_NRF_MRAM)

config NVS
	default y if !(SOC_FLASH_NRF_RRAM || SOC_FLASH_NRF_MRAM)
