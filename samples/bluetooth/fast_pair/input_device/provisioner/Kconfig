config PROV_FP_MODEL_ID
	hex "Fast Pair Model ID (injected by sysbuild)"
	default 0x0
	help
	  Fast Pair Model ID handed to the provisioner by sysbuild from
	  SB_CONFIG_BT_FAST_PAIR_MODEL_ID. Used as input to runtime PSA provisioning.

config PROV_FP_ANTI_SPOOFING_KEY
	string "Fast Pair Anti-Spoofing Private Key (injected by sysbuild)"
	default ""
	help
	  Base64-encoded Anti-Spoofing Private Key handed to the provisioner by
	  sysbuild from SB_CONFIG_BT_FAST_PAIR_ANTI_SPOOFING_PRIVATE_KEY. Confidential;
	  intended to be decoded and stored securely via the PSA API.

source "Kconfig.zephyr"
